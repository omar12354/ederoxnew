# Publieke site-URL (gebruikt voor sitemap, canonical en Open Graph)
NEXT_PUBLIC_SITE_URL=https://ederox.com

# Optioneel: externe planningslink (bijv. Calendly/Cal.com) voor "Plan een kennismaking".
# Leeg = knop verwijst naar /contact.
NEXT_PUBLIC_BOOKING_URL=

# Optioneel: openbaar e-mailadres. Wordt getoond in de footer, de privacyverklaring
# en als alternatief wanneer het formulier tijdelijk niet kan verzenden.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Contactformulier (server-side, NOOIT met NEXT_PUBLIC_ prefix) ----
# Optie A: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optie B: Webhook (bijv. Make, Zapier, n8n of eigen CRM-endpoint). Ontvangt JSON via POST.
CONTACT_WEBHOOK_URL=
